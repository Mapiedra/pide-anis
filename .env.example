# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # ¡secreta! solo en Vercel, nunca en el navegador

# Contraseña para entrar en /admin y ver todos los pedidos
ADMIN_PASSWORD=cambia-esto

# Cadena aleatoria larga para firmar las cookies (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Cierre de pedidos (hora de Madrid). Jueves 3 de diciembre de 2026, 15:00
CLOSE_AT=2026-12-03T15:00:00+01:00
